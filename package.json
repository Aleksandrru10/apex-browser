{
  "name": "apex-browser",
  "version": "1.0.6",
  "description": "Apex Browser - Fusion of Arc, Edge, Firefox, and Chrome with Multi-Profile Isolation",
  "main": "main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder --win",
    "start": "electron .",
    "test": "node test/browser-test.js"
  },
  "build": {
    "appId": "com.aleksandr.apexbrowser",
    "productName": "Apex Browser",
    "copyright": "Copyright © 2026 Aleksandrru10",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apex Browser"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "preload/**/*",
      "package.json"
    ]
  },

  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
